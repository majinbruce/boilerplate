{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run lint:fix)",
      "Bash(npm run format)",
      "Bash(npm run build)",
      "Bash(npm test)",
      "Bash(npm run test:unit)",
      "Bash(npm run test:integration)",
      "Bash(npm run db:generate)",
      "Bash(npm run db:check)",
      "Bash(npx drizzle-kit generate*)",
      "Bash(npx drizzle-kit check*)",
      "Bash(npx vitest run*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(ls*)",
      "Bash(cat*)",
      "Bash(head*)",
      "Bash(tail*)",
      "Bash(wc*)",
      "Bash(find*)",
      "Bash(grep*)",
      "Bash(rg*)"
    ],
    "deny": [
      "Edit(db/migrations/**)",
      "Write(db/migrations/**)",
      "Edit(package-lock.json)",
      "Write(package-lock.json)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/format-and-lint.sh",
            "timeout": 90,
            "statusMessage": "Formatting and linting the edited file..."
          }
        ]
      }
    ]
  }
}
