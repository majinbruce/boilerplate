NODE_ENV=test
PORT=3001
LOG_LEVEL=silent


BETTER_AUTH_SECRET=test-only-better-auth-secret-not-used-anywhere-32
BETTER_AUTH_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3002
# Left ON so the tests exercise the same flow production runs. The auth test
# helper signs up, reads the verification link out of the fake mailer and
# follows it, which is exactly what a real user does.
AUTH_REQUIRE_EMAIL_VERIFICATION=true
COOKIE_SAME_SITE=lax
# The suite injects a fake Mailer through the auth plugin's options, so no
# provider is ever constructed here.
MAIL_PROVIDER=console
EMAIL_FROM=no-reply@test.example.com
APP_NAME=Test App

# Fake, and never contacted: the Google test asserts on the redirect we build,
# not on anything Google returns. Their presence is what registers the provider.
GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_CLIENT_SECRET=test-google-client-secret

PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=app_test

# No proxy in front of app.inject().
TRUST_PROXY=false
