NODE_ENV=test
PORT=3001
LOG_LEVEL=silent


BETTER_AUTH_SECRET=test-only-better-auth-secret-not-used-anywhere-32
BETTER_AUTH_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3002
# Verification is exercised explicitly in its own test via the fake mailer;
# leaving it on globally would make every other test sign in twice.
AUTH_REQUIRE_EMAIL_VERIFICATION=false
COOKIE_SAME_SITE=lax
EMAIL_FROM=no-reply@test.example.com

PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=app_test
PG_SCHEMA=public
