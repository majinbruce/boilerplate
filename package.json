{
  "name": "fastify-ts-boilerplate",
  "version": "1.0.0",
  "description": "Layered Fastify + TypeScript + PostgreSQL boilerplate",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "NODE_ENV=development node --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "NODE_ENV=production node dist/server.js",
    "migrate": "node src/scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\""
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/under-pressure": "^9.1.0",
    "better-auth": "^1.7.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.0",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.15.6",
    "eslint": "^10.8.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
