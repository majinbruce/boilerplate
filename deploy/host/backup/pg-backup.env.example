# Copy to /etc/pg-backup.env, chmod 600 (it holds no secrets today, but the
# rclone config it points at does, and habits are cheaper than incidents).

# Where dumps land on this box. 200 GB of disk means local retention is
# effectively free — keep enough that you can go back past a bug you did not
# notice for a week.
BACKUP_DIR=/var/backups/postgres
LOCAL_RETENTION_DAYS=14

# rclone remote, configured with `rclone config`. Backblaze B2 and Cloudflare
# R2 are both a few cents a month at this size.
#
#   rclone config           # create a remote called e.g. "b2"
#   rclone lsd b2:          # confirm it works before trusting the cron
#
# Leave empty for local-only backups — the script says so out loud when you do,
# because a backup that lives on the machine it is protecting is only half a
# backup.
RCLONE_REMOTE=b2:my-backups/postgres
REMOTE_RETENTION_DAYS=90

# Dead-man's switch. Create a check at https://healthchecks.io (free tier is
# ample), set the period to 1 day with a 6-hour grace, and paste its ping URL.
# You get an alert when the nightly run does NOT happen — which is the failure
# that otherwise looks exactly like everything being fine.
HEALTHCHECK_URL=https://hc-ping.com/your-uuid-here
