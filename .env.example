# Reference only. The real contract is the Zod schema in src/config/index.ts —
# that is what runs on boot and refuses to start on a bad value.
# Copy to .env.development / .env.production. Never commit those.

# Identifies this clone on a host that runs several of them. Read ONLY by
# compose.prod.yml, never by the app — it namespaces the Compose project, the
# built image tag, the volumes, and the network alias Caddy proxies to. Two
# projects sharing a slug are treated as one stack, and the second `up -d`
# adopts the first one's containers and database volume. Required in
# production; irrelevant locally. See deploy/README.md.
PROJECT_SLUG=my-project

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

# Comma separated allow-list, or "*" to reflect any origin.
#
# CORS is registered with credentials: true, so "*" is NOT the harmless public
# API wildcard — it reflects the caller's Origin and lets the browser send
# cookies with it. Fine locally; refused at boot when NODE_ENV=production, where
# you list your frontend origins explicitly:
#   CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=*
BODY_LIMIT_BYTES=1048576

# How far to trust X-Forwarded-For, and therefore what request.ip is.
#   false  no proxy — read the socket address (the safe default)
#   <n>    trust n proxy hops, e.g. 1 behind a single nginx/ALB/Cloudflare
#   <cidr> trust these peers, e.g. 10.0.0.0/8
# Blanket `true` is deliberately not the default: it trusts an X-Forwarded-For
# from anybody, and request.ip is the rate-limit key in front of sign-in and
# password reset. Required in production.
TRUST_PROXY=false

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300


# ---- Better Auth ------------------------------------------------------------
# Generate with: npx auth@latest secret
BETTER_AUTH_SECRET=dev-only-better-auth-secret-change-me-32

# The public origin THIS API is reachable at. Must match the origin whose
# /api/auth/callback/google you registered in the Google Cloud Console.
BETTER_AUTH_URL=http://localhost:3000

# Where the browser lands after verification / reset / OAuth.
FRONTEND_URL=http://localhost:3001

# Comma separated. Defaults to FRONTEND_URL. Every callbackURL a client asks
# for is checked against this list — it is what stops an open redirect.
# TRUSTED_ORIGINS=http://localhost:3001

# Leave both unset to run without Google sign-in; the provider is then simply
# not registered. Set BOTH to turn it on.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# 7 days, refreshed after a day of use.
AUTH_SESSION_EXPIRES_IN_S=604800
AUTH_SESSION_UPDATE_AGE_S=86400
AUTH_REQUIRE_EMAIL_VERIFICATION=true

# Unset COOKIE_SECURE means "secure in production, plain in development".
# COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
# Only needed when the frontend and API are on different subdomains.
# COOKIE_DOMAIN=.example.com

# ---- Mail -------------------------------------------------------------------
# console  log the message and send nothing — the default, so a fresh clone
#          works with no account anywhere: the verification link is printed in
#          your terminal, and you click it from there.
# resend   the real thing. Requires RESEND_API_KEY, and is required itself in
#          production (console is refused at boot there — it "succeeds" while
#          delivering every verification link to nobody).
MAIL_PROVIDER=console

# https://resend.com/api-keys. Only read when MAIL_PROVIDER=resend.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Must be on a domain verified in Resend (resend.com/domains) — an unverified
# sender is rejected with invalid_from_address. onboarding@resend.dev works for
# a first smoke test, but only sends to your own account's address.
EMAIL_FROM=no-reply@example.com

# Optional. Where a reply to a no-reply address should actually land.
# EMAIL_REPLY_TO=support@example.com

# Branding: appears in the auth emails (modules/auth/auth.emails.ts) and as
# Better Auth's appName. Safe to change any time — cookie names do not derive
# from it, so renaming does not sign existing users out.
APP_NAME=Acme

PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=app_db
PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=5000

SHUTDOWN_TIMEOUT_MS=10000

# How long to keep serving after SIGTERM while /health/ready already reports
# 503, so a load balancer can take this instance out of rotation before the
# socket closes. Unset means 5000 in production and 0 here, where nothing is
# polling readiness and the delay would only make Ctrl+C feel broken.
# SHUTDOWN_DRAIN_MS=0

# ---- Error tracking ---------------------------------------------------------
# Unset (the default) means Sentry is never initialised and nothing leaves the
# process. Set the DSN from your Sentry project to turn it on; only unexpected
# 500s and crashes are reported, never 4xx.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# 0 sends errors only. Raise to ~0.1 when you want performance traces too.
# SENTRY_TRACES_SAMPLE_RATE=0
# Defaults to NODE_ENV. Set it when staging and production share a project.
# SENTRY_ENVIRONMENT=
# The build this process is running, so a stack trace points at a commit.
# APP_VERSION=
