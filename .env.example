# Reference only. The real contract is the Zod schema in src/config/index.ts —
# that is what runs on boot and refuses to start on a bad value.
# Copy to .env.development / .env.production. Never commit those.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

# Comma separated allow-list, or "*" to reflect any origin.
CORS_ORIGINS=*
BODY_LIMIT_BYTES=1048576

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Minimum 32 characters — enforced at boot.
JWT_SECRET=dev-only-secret-change-me-in-production-32
JWT_EXPIRES_IN=1d

# ---- Better Auth ------------------------------------------------------------
# Generate with: npx auth@latest secret
BETTER_AUTH_SECRET=dev-only-better-auth-secret-change-me-32

# The public origin THIS API is reachable at. Must match the origin whose
# /api/auth/callback/google you registered in the Google Cloud Console.
BETTER_AUTH_URL=http://localhost:3000

# Where the browser lands after verification / reset / OAuth.
FRONTEND_URL=http://localhost:3001

# Comma separated. Defaults to FRONTEND_URL. Every callbackURL a client asks
# for is checked against this list — it is what stops an open redirect.
# TRUSTED_ORIGINS=http://localhost:3001

# Leave both unset to run without Google sign-in; the provider is then simply
# not registered. Set BOTH to turn it on.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# 7 days, refreshed after a day of use.
AUTH_SESSION_EXPIRES_IN_S=604800
AUTH_SESSION_UPDATE_AGE_S=86400
AUTH_REQUIRE_EMAIL_VERIFICATION=true

# Unset COOKIE_SECURE means "secure in production, plain in development".
# COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
# Only needed when the frontend and API are on different subdomains.
# COOKIE_DOMAIN=.example.com

EMAIL_FROM=no-reply@localhost

PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=app_db
PG_SCHEMA=public
PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=5000

SHUTDOWN_TIMEOUT_MS=10000
